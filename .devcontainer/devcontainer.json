{
  "name": "Loki",
  "image": "ghcr.io/llvmparty/loki:20230720-18.04-llvm9",
  "remoteUser": "user",
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/user/loki,type=bind,consistency=cached",
  "workspaceFolder": "/home/user/loki",
  "runArgs": [
    "--privileged",
    "--net=host",
    "--mount", "type=tmpfs,destination=/tmp,tmpfs-mode=777",
    "--ulimit", "msgqueue=2097152000",
    "--shm-size=16G"
  ],
  "containerEnv": {
    "PARALLEL_JOBS": "${localEnv:PARALLEL_JOBS}"
  },
  "postCreateCommand": "./setup.sh"
}
